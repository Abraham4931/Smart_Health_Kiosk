PORT=5000
# 1 = mongodb-memory-server (dev). 0 = use MONGODB_URI
MONGODB_MEMORY_SERVER=1
MONGODB_URI=mongodb://127.0.0.1:27017/smart_health_kiosk
# SKIP_AUTO_SEED=1
# MQTT_DISABLED=1

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

GOOGLE_MAPS_API_KEY=

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

UPLOAD_DIR=./uploads
